---
import { education } from "../data/content";
import Section from "../components/Section.astro";
import Badge from "../components/Badge.astro";
---

<Section id="education" title="Education" index={3}>
  <div class="space-y-4">
    {
      education.map((item) => (
        <div class="flex flex-col gap-2 rounded-sm border border-zinc-200 p-5 sm:flex-row sm:items-start sm:justify-between sm:gap-4 dark:border-zinc-800">
          <div>
            <h3 class="text-base font-semibold text-zinc-900 dark:text-zinc-50">
              {item.title} - {item.field}
            </h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400">
              {item.institution} · {item.period}
            </p>
            {item.thesis && (
              <p class="mt-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-300">
                <span class="font-mono text-xs text-accent-strong dark:text-accent">
                  thesis:{" "}
                </span>
                {item.thesis}
              </p>
            )}
          </div>
          <Badge variant="accent">{item.grade}</Badge>
        </div>
      ))
    }
  </div>
</Section>
