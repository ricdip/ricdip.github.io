---
import { projects } from "../data/content";
import Section from "../components/Section.astro";
import Badge from "../components/Badge.astro";
---

<Section id="projects" title="Projects" index={6}>
  <div class="grid gap-6 sm:grid-cols-2">
    {
      projects.map((project) => (
        <article class="flex flex-col rounded-sm border border-zinc-200 p-5 transition-colors hover:border-accent dark:border-zinc-800 dark:hover:border-accent">
          <div class="mb-2 flex items-start justify-between gap-3">
            <h3 class="text-base font-semibold text-zinc-900 dark:text-zinc-50">
              {project.name}
            </h3>
          </div>
          <p class="flex-1 text-sm leading-relaxed text-zinc-600 dark:text-zinc-300">
            {project.summary}
          </p>
          <div class="mt-4 flex flex-wrap gap-2">
            {project.tech.map((t) => (
              <Badge>{t}</Badge>
            ))}
          </div>
          {(project.closedSource || project.planned || project.url) && (
            <div class="mt-4 flex flex-wrap items-center gap-3 border-t border-zinc-200 pt-3 dark:border-zinc-800">
              {project.planned && <Badge variant="accent">Planned</Badge>}
              {project.closedSource && (
                <Badge variant="muted">Closed source</Badge>
              )}
              {project.url && (
                <a
                  href={project.url}
                  class="font-mono text-xs text-accent-strong hover:underline dark:text-accent"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  View →
                </a>
              )}
            </div>
          )}
        </article>
      ))
    }
  </div>
</Section>
