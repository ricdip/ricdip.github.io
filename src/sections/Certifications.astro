---
import { certifications } from "../data/content";
import Section from "../components/Section.astro";
import Badge from "../components/Badge.astro";
---

<Section id="certifications" title="Certifications" index={4}>
  <ul class="space-y-3">
    {
      certifications.map((cert) => (
        <li class="flex flex-col gap-2 rounded-sm border border-zinc-200 p-4 sm:flex-row sm:items-start sm:justify-between sm:gap-4 dark:border-zinc-800">
          <div>
            <p class="text-sm font-medium text-zinc-900 dark:text-zinc-100">
              {cert.name}
            </p>
            <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-300">
              {cert.content}
            </p>
            <p class="mt-1 font-mono text-xs text-zinc-500 dark:text-zinc-400">
              {cert.duration}
            </p>
          </div>
          <span class="flex shrink-0 items-center gap-3">
            <Badge>{cert.issuer}</Badge>
            <span class="font-mono text-xs text-zinc-500 dark:text-zinc-400">
              {cert.date}
            </span>
          </span>
        </li>
      ))
    }
  </ul>
</Section>
