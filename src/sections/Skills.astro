---
import { skills } from "../data/content";
import Section from "../components/Section.astro";
import Badge from "../components/Badge.astro";
---

<Section id="skills" title="Skills" index={5}>
  <div class="space-y-px overflow-hidden rounded-sm border border-zinc-200 dark:border-zinc-800">
    <!-- Column headers (hidden on mobile where rows stack) -->
    <div
      class="hidden grid-cols-12 gap-4 bg-zinc-100 px-4 py-3 font-mono text-xs uppercase tracking-wide text-zinc-500 sm:grid dark:bg-zinc-900 dark:text-zinc-400"
    >
      <div class="col-span-3">Category</div>
      <div class="col-span-5">Main</div>
      <div class="col-span-4">Know / have used</div>
    </div>

    {
      skills.map((row) => (
        <div class="grid grid-cols-1 items-start gap-3 border-t border-zinc-200 px-4 py-4 sm:grid-cols-12 sm:gap-4 dark:border-zinc-800">
          <div class="col-span-3 font-mono text-sm font-semibold text-zinc-900 dark:text-zinc-100">
            {row.category}
          </div>
          <div class="col-span-5 flex flex-wrap items-start gap-2">
            {row.main.length > 0 ? (
              row.main.map((s) => <Badge variant="accent">{s}</Badge>)
            ) : (
              <span class="text-sm text-zinc-400 dark:text-zinc-600">-</span>
            )}
          </div>
          <div class="col-span-4 flex flex-wrap items-start gap-2">
            {row.familiar.length > 0 ? (
              row.familiar.map((s) => <Badge>{s}</Badge>)
            ) : (
              <span class="text-sm text-zinc-400 dark:text-zinc-600">-</span>
            )}
          </div>
        </div>
      ))
    }
  </div>
</Section>
