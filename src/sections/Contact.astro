---
import { site } from "../data/content";
import Section from "../components/Section.astro";
import CvButton from "../components/CvButton.astro";

const links = [
  {
    label: "GitHub",
    value: "github.com/ricdip",
    href: site.github,
  },
  {
    label: "LinkedIn",
    value: "riccardo-armando-di-prinzio",
    href: site.linkedin,
  },
];
---

<Section id="contact" title="Contact" index={8}>
  <p
    class="max-w-2xl text-base leading-relaxed text-zinc-600 dark:text-zinc-300"
  >
    Feel free to reach out - whether about a project, a collaboration, or simply
    to talk about software engineering, and systems administration.
  </p>

  <ul class="mt-8 space-y-3">
    {
      links.map((c) => (
        <li class="flex items-center gap-3">
          <span class="w-20 font-mono text-xs tracking-wide text-zinc-500 uppercase dark:text-zinc-400">
            {c.label}
          </span>
          <a
            href={c.href}
            target="_blank"
            rel="noopener noreferrer"
            class="font-mono text-sm text-zinc-800 transition-colors hover:text-accent-strong dark:text-zinc-200 dark:hover:text-accent"
          >
            {c.value}
          </a>
        </li>
      ))
    }

    <!-- Email: assembled client-side from parts so the full address never
         appears in the static HTML source (deters scrapers). -->
    <li class="flex items-center gap-3">
      <span
        class="w-20 font-mono text-xs tracking-wide text-zinc-500 uppercase dark:text-zinc-400"
      >
        Email
      </span>
      <a
        id="email-link"
        data-user={site.emailUser}
        data-domain={site.emailDomain}
        class="min-w-0 font-mono text-sm break-all text-zinc-800 transition-colors hover:text-accent-strong dark:text-zinc-200 dark:hover:text-accent"
      >
        <noscript>enable JavaScript to view</noscript>
      </a>
      <!-- Copy button: hidden by default, revealed by JS (needs the client-side
           assembled address + the Clipboard API). -->
      <button
        id="email-copy"
        type="button"
        hidden
        aria-label="Copy email address"
        class="inline-flex h-7 w-7 shrink-0 cursor-pointer items-center justify-center rounded-sm border border-zinc-300 text-zinc-500 transition-colors hover:border-accent hover:text-accent-strong focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent dark:border-zinc-700 dark:text-zinc-400 dark:hover:border-accent dark:hover:text-accent"
      >
        <!-- Copy icon (default state) -->
        <svg
          data-icon="copy"
          class="h-4 w-4"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
          ></path>
        </svg>
        <!-- Check icon (shown briefly after a successful copy) -->
        <svg
          data-icon="check"
          class="hidden h-4 w-4 text-accent-strong dark:text-accent"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M20 6 9 17l-5-5"></path>
        </svg>
      </button>
    </li>
  </ul>

  <div class="mt-10">
    <CvButton variant="primary" />
  </div>
</Section>

<script>
  const el = document.getElementById("email-link");
  if (el) {
    const user = el.dataset.user ?? "";
    const domain = el.dataset.domain ?? "";
    const address = `${user}@${domain}`;
    el.setAttribute("href", `mailto:${address}`);
    el.textContent = address;

    // Reveal and wire the copy button only once the address exists client-side.
    const copyBtn = document.getElementById("email-copy");
    if (copyBtn) {
      const copyIcon = copyBtn.querySelector<SVGElement>('[data-icon="copy"]');
      const checkIcon = copyBtn.querySelector<SVGElement>(
        '[data-icon="check"]',
      );
      copyBtn.hidden = false;

      let resetTimer: ReturnType<typeof setTimeout> | undefined;
      copyBtn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(address);
        } catch {
          return; // clipboard unavailable or denied — leave the button as-is
        }
        copyIcon?.classList.add("hidden");
        checkIcon?.classList.remove("hidden");
        copyBtn.setAttribute("aria-label", "Email address copied");
        clearTimeout(resetTimer);
        resetTimer = setTimeout(() => {
          checkIcon?.classList.add("hidden");
          copyIcon?.classList.remove("hidden");
          copyBtn.setAttribute("aria-label", "Copy email address");
        }, 2000);
      });
    }
  }
</script>
