---
// Monospace pill used for skills and tech tags.
interface Props {
  variant?: "default" | "accent" | "muted";
}
const { variant = "default" } = Astro.props;

const styles = {
  default:
    "border-zinc-300 bg-zinc-100 text-zinc-700 dark:border-zinc-700 dark:bg-zinc-800/60 dark:text-zinc-300",
  accent: "border-accent/40 bg-accent/10 text-accent-strong dark:text-accent",
  muted:
    "border-zinc-200 bg-transparent text-zinc-500 dark:border-zinc-800 dark:text-zinc-400",
};
---

<span
  class:list={[
    "inline-flex items-center rounded-sm border px-2 py-0.5 font-mono text-xs leading-5",
    styles[variant],
  ]}
>
  <slot />
</span>
