---
// Reusable section wrapper: anchor id, numbered monospace heading, sharp separator.
interface Props {
  id: string;
  title: string;
  index: number;
}
const { id, title, index } = Astro.props;
const num = String(index).padStart(2, "0");
---

<section
  id={id}
  class="border-t border-zinc-200 py-16 sm:py-24 dark:border-zinc-800"
>
  <div class="mx-auto max-w-5xl px-6">
    <h2 class="mb-10 flex items-baseline gap-3">
      <span class="font-mono text-sm text-accent-strong dark:text-accent"
        >{num}.</span
      >
      <span class="text-2xl font-bold tracking-tight text-zinc-900 sm:text-3xl dark:text-zinc-50"
        >{title}</span
      >
    </h2>
    <slot />
  </div>
</section>
