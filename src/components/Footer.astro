---
import { site } from "../data/content";

const year = new Date().getFullYear();
---

<footer class="border-t border-zinc-200 py-8 dark:border-zinc-800">
  <div class="mx-auto flex max-w-5xl flex-col items-center gap-1 px-6 text-center">
    <p class="font-mono text-sm text-zinc-600 dark:text-zinc-300">
      © {year} {site.name}
    </p>
    <p class="font-mono text-xs text-zinc-500 dark:text-zinc-500">
      Built with Astro &amp; Tailwind
    </p>
  </div>
</footer>
